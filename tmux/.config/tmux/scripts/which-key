# SPDX-License-Identifier: MIT
#
# desc: 前缀 ? 的快捷键速查浮窗（从 tmux.conf 的 #@ 注解生成）

# which-key — 快捷键速查 float 弹窗（前缀 C-b）。
# 由 tmux.conf 的 display-popup 直接以 bash 运行。
#
# 数据源: tmux.conf 里的 `#@ 分组 | 按键 | 说明` 注解——与 docs/tmux.md 的键位表
# 同源，改键位只需改 tmux.conf 一处。
#
# 环境变量: TMUX_CONF 可覆盖配置路径（测试时用）。

set -u

conf="${TMUX_CONF:-$HOME/.config/tmux/tmux.conf}"

cat <<'EOF'

  tmux 快捷键速查  前缀 = Ctrl-b  (Termux: 音量+ 与 b 同按)
  每个标签页是一个分组会话，名字如 calm-otter，显示在左上角
EOF

# 按分组首次出现的顺序输出，同组不重复标题；前缀键加 "C-b " 前缀。
awk -F' [|] ' '
    /^#@ / {
        sub(/^#@ /, "")
        group = $1; key = $2; desc = $3
        if (!(group in seen)) { seen[group] = 1; order[++n] = group }
        if (group == "无前缀" || group == "复制模式") line[group, ++cnt[group]] = key "\t" desc
        else line[group, ++cnt[group]] = "C-b " key "\t" desc
    }
    END {
        for (i = 1; i <= n; i++) {
            g = order[i]
            printf "\n  %s\n", g
            for (j = 1; j <= cnt[g]; j++) {
                split(line[g, j], kv, "\t")
                printf "    %-20s %s\n", kv[1], kv[2]
            }
        }
    }
' "$conf" 2>/dev/null || true

cat <<'EOF'

  提示: 无前缀 = 直接按，无需先按 Ctrl-b

  按回车关闭...
EOF

read -r _
