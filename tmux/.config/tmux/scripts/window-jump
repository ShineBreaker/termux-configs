#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT

# window-jump — fzf 跨 session 窗口跳转（前缀 C-b + f），移植自 Guix-configs，
# 只依赖 tmux + fzf，Termux 可直接使用。
set -euo pipefail

current_session=$(tmux display -p "#{session_name}")

# 每个标签页都是 main 的分组会话，同一批窗口会出现多次；按 window_id 去重，
# 并让当前标签页的那一份排在前面（跳转时留在本标签页，不改会话名）。
fmt=$'#{window_id}\t#{session_name}\t#{window_index}\t#{window_name}\t#{pane_current_path}\t#{window_panes}'
windows=$(
  {
    tmux list-windows -t "$current_session" -F "$fmt" 2>/dev/null
    tmux list-windows -a -F "$fmt" 2>/dev/null
  } | awk -F'\t' '!seen[$1]++'
) || true

if [[ -z "$windows" ]]; then
  tmux display-message "没有可跳转的窗口"
  exit 0
fi

choices=()
while IFS=$'\t' read -r _win session idx name path panes; do
  pane_label="pane"
  [[ "$panes" -gt 1 ]] && pane_label="panes"
  short_path="${path%/}"
  short_path="${short_path##*/}"
  [[ -n "$short_path" ]] || short_path="/"

  if [[ "$session" == "$current_session" ]]; then
    choices+=("[当前] $name  $short_path  ($panes $pane_label)"$'\t'"$session"$'\t'"$idx")
  else
    choices+=("  $name  $short_path  ($panes $pane_label)  <- $session"$'\t'"$session"$'\t'"$idx")
  fi
done <<<"$windows"

result=$(printf '%s\n' "${choices[@]}" \
  | fzf --reverse --no-multi \
    --header="跳转到窗口" \
    --height=~50% \
    --with-nth=1 \
    --delimiter=$'\t' \
  || true)

if [[ -z "$result" ]]; then
  exit 0
fi

IFS=$'\t' read -r _ target_session target_window <<<"$result"

if [[ "$target_session" == "$current_session" ]]; then
  tmux select-window -t "$target_window"
else
  tmux switch-client -t "${target_session}:${target_window}"
fi
