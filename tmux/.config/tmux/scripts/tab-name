#!/data/data/com.termux/files/usr/bin/bash

# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
#
# desc: 生成人类可读且唯一的标签页会话名，顺手回收残留的分组会话

# tab-name — 为新建的 tmux 标签页生成一个人类可读、当前 server 内唯一的会话名。
#
# 输出形如 calm-otter 的「形容词-动物」短名：比 pts/N 好记，也不会和已有会话
# 撞名（撞了就重抽）。会话名会出现在状态栏左侧、终端标题、`tmux ls`、MOTD 和
# 会话列表里，相当于给每个标签页挂一个标识符。
#
# 副作用：顺手回收残留的分组会话（见 tmux.conf 的分组说明）。Termux 被系统
# 强杀时客户端来不及正常 detach，分组会话会零客户端地留在后台，下次开标签页
# 时清掉，避免 `tmux ls` 越攒越长。
#
# 环境变量：
#   TMUX_TAB_NAME  直接指定名字（不做去重，重名时由 tmux 报错）
#
# 【超时护栏】本脚本在 fish 启动路径上运行，一旦卡住整个 shell 都起不来。
# tmux server 假死时（进程还在、socket 还在，但不再处理命令）任何 tmux 命令
# 都会永久阻塞，因此：
#   1. 所有 tmux 调用都用 timeout -k（SIGTERM 无效再 SIGKILL），保证一定返回；
#   2. 输出写临时文件而不是管道 —— tmux 派生的 server 进程可能长期持有管道
#      写端，管道读端会一直等不到 EOF。

set -u

# 在超时内执行 tmux，输出写入文件；返回 timeout 的退出码
tmux_capture() { # tmux_capture <输出文件> <tmux 参数...>
    local out="$1"; shift
    command timeout -k 1 2 tmux "$@" >"$out" 2>/dev/null </dev/null
}

# 在超时内执行 tmux，只关心成败
tmux_quiet() {
    command timeout -k 1 2 tmux "$@" >/dev/null 2>&1 </dev/null
}

# 想加词直接往数组里塞（尽量选短、无歧义的英文单词）
adjs=(calm bold keen warm neat swift quiet brave crisp tidy mellow sunny rapid cosy)
animals=(otter fox lynx panda koala heron raven moose gecko squid crane bison tapir wombat badger magpie)

if [ -n "${TMUX_TAB_NAME:-}" ]; then
    printf '%s\n' "$TMUX_TAB_NAME"
    exit 0
fi

# 回收残留：零客户端 + 属于分组（session_group 非空）+ 不是锚点 main
# 用 tab 作分隔符，会话名里带空格（前缀 N 改名）也不会解析错位
sessions_file=$(mktemp)
tmux_capture "$sessions_file" list-sessions -F $'#{session_name}\t#{session_attached}\t#{session_group}'
while IFS=$'\t' read -r name attached group; do
    [ -n "$name" ] || continue
    [ -n "$group" ] || continue
    [ "$attached" = 0 ] || continue
    [ "$name" = main ] && continue
    tmux_quiet kill-session -t "=$name"
done < "$sessions_file"
rm -f "$sessions_file"

taken_file=$(mktemp)
tmux_capture "$taken_file" list-sessions -F '#{session_name}'
taken=$(cat "$taken_file")
rm -f "$taken_file"

for _ in $(seq 40); do
    candidate="${adjs[RANDOM % ${#adjs[@]}]}-${animals[RANDOM % ${#animals[@]}]}"
    if ! printf '%s\n' "$taken" | grep -qxF "$candidate"; then
        printf '%s\n' "$candidate"
        exit 0
    fi
done

# 词库抽 40 次都撞名：退回带随机数的名字，保证唯一
printf 'tab-%s\n' "$RANDOM"
