#!/data/data/com.termux/files/usr/bin/bash

# SPDX-FileCopyrightText: 2026 BrokenShine <xchai404@gmail.com>
#
# SPDX-License-Identifier: MIT
#
# desc: 前缀 C 新建标签页（自动取名，挂进当前分组并切过去）

# new-tab — 在 tmux 内新建一个标签页会话（前缀 C），沿用 tab-name 的可读命名。
#
# 与 Termux 新标签页保持一致：默认挂到 main 的分组里（共享窗口与历史），
# 若 main 不存在则挂到当前会话所在的分组，再不行才建一个独立会话。
# 由 tmux.conf 的 `bind C` 以 run-shell 调用，因此能拿到当前客户端/窗格上下文。

set -u

here=$(dirname "$(readlink -f "$0")")

# tmux 调用一律加超时: server 假死时命令会永久阻塞 (见 tab-name 的说明)
tmux_quiet() {
    command timeout -k 1 2 tmux "$@" >/dev/null 2>&1 </dev/null
}

# 取 tmux 格式串的值: 输出走临时文件, 避免管道被 tmux 派生进程长期持有
tmux_value() { # tmux_value <格式串>
    local fmt="$1" out
    out=$(mktemp)
    command timeout -k 1 2 tmux display -p "$fmt" >"$out" 2>/dev/null </dev/null
    cat "$out"
    rm -f "$out"
}

name=$(bash "$here/tab-name" 2>/dev/null) || exit 0
[ -n "$name" ] || exit 0

group=$(tmux_value '#{session_group}')
[ -n "$group" ] || group=$(tmux_value '#{session_name}')

# 新窗口/会话沿用当前窗格路径（分组会话不新建窗口，路径只在兜底时生效）
cwd=$(tmux_value '#{pane_current_path}')
[ -n "$cwd" ] || cwd=$PWD

tmux_quiet new-session -d -c "$cwd" -t "$group" -s "$name" \
    || tmux_quiet new-session -d -c "$cwd" -s "$name" \
    || exit 0

tmux_quiet switch-client -t "$name"
exit 0
