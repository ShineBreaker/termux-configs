function cheat
    echo (set_color cyan)"╔════════════════════════════════════════╗"
    echo (set_color cyan)"║     📱 Termux Fish 快捷命令参考        ║"
    echo (set_color cyan)"╚════════════════════════════════════════╝"
    echo
    echo (set_color yellow)"📂 导航:"
    echo (set_color normal)"  ..     返回上级目录"
    echo "  ...    返回上两级"
    echo "  ~      返回主目录"
    echo "  l      详细列表 (ls -la)"
    echo "  ll     详细列表 (ls -la)"
    echo "  la     同 l (ls -la)"
    echo "  lt     按时间排序"
    echo "  cd     zoxide 智能跳转 (需安装 zoxide)"
    echo
    echo (set_color yellow)"🛠️  现代 CLI 别名 (装对应包后自动启用):"
    echo (set_color normal)"  ls → eza    目录优先/彩色"
    echo "  cat → bat   语法高亮"
    echo "  du → dust   磁盘占用树"
    echo "  find → fd   快速查找"
    echo "  grep → rg   快速搜索"
    echo "  catr → cat  绕过 bat 使用系统 cat"
    echo "  cp/rm       默认 -i 确认 (安全默认)"
    echo
    echo (set_color yellow)"📦 包管理:"
    echo (set_color normal)"  pkgi   安装包"
    echo "  pkgu   更新所有包"
    echo "  pkgs   搜索包"
    echo "  pkgl   列出已安装"
    echo
    echo (set_color yellow)"🔀 Git:"
    echo (set_color normal)"  g          git"
    echo "  status     git status -sb"
    echo "  add        git add"
    echo "  commit     git commit (打开模板)"
    echo "  commitall  git commit --all"
    echo "  push       git push"
    echo "  pull       git pull"
    echo "  fetch      git fetch"
    echo "  diff       git diff (系统 diff 用 command diff)"
    echo "  log        git log"
    echo "  clone      git clone"
    echo
    echo (set_color yellow)"📊 系统信息 (Fastfetch):"
    echo (set_color normal)"  ff         显示系统信息"
    echo "  ffmini     紧凑模式 (小屏幕)"
    echo "  fffull     完整模式"
    echo "  ffcfg      编辑标准配置"
    echo "  ffcfgmini  编辑紧凑配置"
    echo
    echo (set_color yellow)"⚡ 其他:"
    echo (set_color normal)"  c      清屏"
    echo "  q      退出"
    echo "  h      历史记录"
    echo "  enter  SSH 登录电脑 (tailscale ssh)"
    echo "  retry  命令失败时自动重试 (网络抖动时)"
    echo "  run    运行当前目录的 justfile"
    echo "  update 更新系统 (函数)"
    echo "  termux-reload  重载设置 (函数)"
    echo
    echo (set_color yellow)"🧩 tmux 会话复用:"
    echo (set_color normal)"  新标签页自动进 tmux，会话名如 calm-otter (状态栏左上角)"
    echo "  共享 main 的窗口/历史 (分组会话)   前缀 N 改名   C 新建标签页"
    echo "  跳过: TMUX_AUTO=0 fish  完全独立: TMUX_AUTO=tab fish"
    echo "  前缀 Ctrl-b (音量+ + b): ? 帮助  s 会话列表  f 跳窗口"
    echo "  分屏: \\ 左右 / - 上下   复制: [ 进入, v 选, y 复制   粘贴: p"
    echo
    echo (set_color yellow)"📝 编辑配置:"
    echo (set_color normal)"  fishrc     编辑 Fish 配置"
    echo "  termuxrc   编辑 Termux 配置"
    echo "  helixrc    编辑 Helix 配置"
    echo "  starshiprc 编辑 Starship 提示符"
    echo "  atuinrc    编辑 Atuin 历史搜索"
    echo "  gitrc      编辑 Git 全局配置"
    echo "  ee         终端内打开 Emacs"
    echo
    echo (set_color yellow)"⚡ just 一键指令:"
    echo (set_color normal)"  just               查看全部指令"
    echo "  just setup         完整安装"
    echo "  just install       装软件 (packages.txt)"
    echo "  just install-pi    安装/升级 Pi 编码助手"
    echo "  just install-tailscale  安装/升级 Tailscale"
    echo "  just export        导出软件清单"
    echo "  just install-emacs 安装 Emacs (UniEmacs，含预构建)"
    echo "  just restow        重新链接全部配置包"
    echo "  just status        检查链接状态"
    echo
    echo (set_color yellow)"📦 Dotfiles 管理:"
    echo (set_color normal)"  dot cd              进入 dotfiles 目录"
    echo "  dot path            输出仓库路径"
    echo "  dot stow <包>       链接配置包"
    echo "  dot unstow <包>     取消链接"
    echo "  dot restow <包>     重新链接"
    echo "  dot list            列出所有包"
    echo "  dot status          检查链接状态"
    echo "  dot add <包>        添加新包"
    echo
    echo (set_color cyan)"💡 提示: 按 TAB 键自动补全命令"
    echo
end
